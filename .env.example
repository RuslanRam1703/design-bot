# Токен бота — выдаёт @BotFather в Telegram
BOT_TOKEN=

# chat_id дизайнера, куда будут приходить заявки.
# Узнать свой chat_id: напишите боту /id после первого запуска.
DESIGNER_CHAT_ID=

# Публичный HTTPS-адрес, по которому будет открываться Mini App
# (адрес хостинга из README, например https://my-design-bot.onrender.com).
# ВАЖНО: без слэша на конце.
WEBAPP_URL=

# Порт, на котором поднимается веб-сервер Mini App внутри контейнера/сервера.
# На Render.com и подобных платформах он обычно подставляется автоматически —
# трогать не нужно.
PORT=8080

# Опционально: Upstash Redis (REST API, бесплатный тариф на upstash.com) —
# делает данные (заявки и все правки через /admin) персистентными на
# бесплатном Render, где файловая система эфемерна и сбрасывается на
# каждый restart/redeploy. Без этих двух переменных бот работает как
# раньше — обычные локальные файлы в data/*.json (для локальной
# разработки заводить Upstash не нужно).
# Взять значения: console.upstash.com -> ваша база -> вкладка REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Опционально: Cloudflare R2 — персистентное хранилище для самих файлов
# фото портфолио/about (Upstash выше хранит только JSON-метаданные, ссылки
# на эти файлы; сами байты фото на бесплатном Render иначе живут только на
# эфемерном диске и пропадают на каждом restart/redeploy). Без этих
# переменных — поведение как раньше: фото сохраняются локально в
# webapp/img/ (для локальной разработки R2-аккаунт не нужен).
# R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_BUCKET_NAME:
# dash.cloudflare.com -> R2 -> Manage API Tokens -> создать токен с правами
# "Object Read & Write" на нужный bucket.
# R2_PUBLIC_BASE_URL — публичный адрес, с которого отдаются загруженные
# фото (например, https://pub-xxxx.r2.dev — включается в настройках bucket,
# "Public access"; для боевого продакшена Cloudflare рекомендует вместо
# r2.dev привязать собственный домен — см. R2 Custom Domains). БЕЗ слэша
# на конце.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
